
"use client";

import Image from "next/image";
import Link from "next/link";
import { motion, useReducedMotion } from "framer-motion";
import { ArrowDown, ArrowUpRight, Sparkles } from "lucide-react";

import Header from "@/components/layout/Header";

export default function Hero() {
    const reduced = useReducedMotion();

    return (
        <section className="hero-section hero-v2-section" id="top">
            <div className="hero-v2-background" aria-hidden="true" />
            <div className="hero-v2-grain" aria-hidden="true" />

            <Header />

            <div className="hero-v2-grid page-gutter">

                <div className="hero-v2-copy">

                    <motion.div
                        className="hero-v2-kicker"
                        initial={reduced ? false : { opacity: 0, y: 20 }}
                        animate={{ opacity: 1, y: 0 }}
                        transition={{ duration: 0.8, delay: 0.2 }}
                    >
                        <span className="hero-v2-kicker-icon">
                            <Sparkles size={17} strokeWidth={1.4} />
                        </span>

                        <span>ADVANCED AESTHETICS</span>

                        <span className="hero-v2-kicker-divider" />

                        <span>PERSONAL BY NATURE</span>
                    </motion.div>

                    <motion.h1
                        className="hero-v2-title"
                        initial={reduced ? false : { opacity: 0, y: 55 }}
                        animate={{ opacity: 1, y: 0 }}
                        transition={{
                            duration: 1.1,
                            delay: 0.3,
                            ease: [0.22, 1, 0.36, 1],
                        }}
                    >
                        <span>The beauty of</span>
                        <span>
                            being <em>you.</em>
                        </span>
                    </motion.h1>

                    <motion.div
                        className="hero-v2-divider"
                        initial={reduced ? false : { width: 0 }}
                        animate={{ width: "100%" }}
                        transition={{ duration: 0.9, delay: 0.65 }}
                    >
                        <span />
                    </motion.div>

                    <motion.p
                        className="hero-v2-description"
                        initial={reduced ? false : { opacity: 0, y: 25 }}
                        animate={{ opacity: 1, y: 0 }}
                        transition={{ duration: 0.8, delay: 0.65 }}
                    >
                        Thoughtful skin and aesthetic care, guided by your
                        goals and tailored to you. A welcoming space for
                        every skin, every story and every expression of self.
                    </motion.p>

                    <motion.div
                        className="hero-v2-actions"
                        initial={reduced ? false : { opacity: 0, y: 20 }}
                        animate={{ opacity: 1, y: 0 }}
                        transition={{ duration: 0.8, delay: 0.85 }}
                    >
                        <Link href="#treatments" className="hero-v2-primary">
                            <span>Explore our treatments</span>

                            <span className="hero-v2-cta-icon">
                                <ArrowUpRight size={19} strokeWidth={1.6} />
                            </span>
                        </Link>

                        <Link href="#contact" className="hero-v2-secondary">
                            <span>Begin your journey</span>
                            <ArrowUpRight size={16} />
                        </Link>
                    </motion.div>

                    <motion.div
                        className="hero-v2-details"
                        initial={reduced ? false : { opacity: 0 }}
                        animate={{ opacity: 1 }}
                        transition={{ duration: 1, delay: 1 }}
                    >
                        <div className="hero-v2-detail">
                            <span className="hero-v2-detail-number">01</span>
                            <span>SKIN · LASER · REJUVENATION</span>
                        </div>

                        <div className="hero-v2-detail">
                            <span className="hero-v2-detail-dot" />
                            <span>CARE FOR EVERY SKIN</span>
                        </div>
                    </motion.div>

                </div>

                <motion.div
                    className="hero-v2-visual"
                    initial={reduced ? false : { opacity: 0, y: 45 }}
                    animate={{ opacity: 1, y: 0 }}
                    transition={{
                        duration: 1.2,
                        delay: 0.25,
                        ease: [0.22, 1, 0.36, 1],
                    }}
                >
                    <div className="hero-v2-halo" aria-hidden="true" />
                    <div className="hero-v2-orbit" aria-hidden="true" />

                    <motion.div
                        className="hero-v2-image-frame"
                        initial={
                            reduced
                                ? false
                                : {
                                    clipPath: "inset(16% 0 0 0 round 50% 50% 4px 4px)",
                                    scale: 1.04,
                                }
                        }
                        animate={{
                            clipPath: "inset(0% 0 0 0 round 50% 50% 4px 4px)",
                            scale: 1,
                        }}
                        transition={{
                            duration: 1.6,
                            delay: 0.3,
                            ease: [0.76, 0, 0.24, 1],
                        }}
                    >
                        <Image
                            src="/images/elysea-hero.png"
                            alt="Editorial portrait celebrating natural skin and beauty"
                            fill
                            priority
                            sizes="(max-width: 900px) 100vw, 48vw"
                            className="hero-v2-image"
                        />

                        <div className="hero-v2-image-overlay" />

                        <div className="hero-v2-image-caption">
                            <span>THE ELYSEA EXPERIENCE</span>
                            <strong>Care, with intention.</strong>
                        </div>
                    </motion.div>

                    <motion.div
                        className="hero-v2-seal"
                        initial={reduced ? false : { opacity: 0, scale: 0.7 }}
                        animate={{ opacity: 1, scale: 1 }}
                        transition={{
                            duration: 0.9,
                            delay: 1.1,
                            ease: [0.22, 1, 0.36, 1],
                        }}
                    >
                        <span className="hero-v2-seal-brand">ELYSEA</span>
                        <Sparkles size={23} strokeWidth={1.1} />
                        <span className="hero-v2-seal-caption">
                            SKIN · SCIENCE · SELF
                        </span>
                    </motion.div>

                    <div className="hero-v2-side-text">
                        PERSONAL BEAUTY, REIMAGINED
