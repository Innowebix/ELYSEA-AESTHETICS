            >
                <span>SCROLL TO DISCOVER</span>
                <span className="hero-v2-scroll-line" />
                <ArrowDown size={17} strokeWidth={1.3} />
            </Link>

            <div className="hero-v2-bottom-note">
                ELYSEA AESTHETICS — AN APPROACH TO YOU
            </div>
